# O servidor inicia em modo gratuito. Nunca copie credenciais reais para o Git.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# Fail-closed: todos os requisitos abaixo precisam estar válidos simultaneamente.
ENABLE_REAL_MONEY=false
# Alias legado aceito durante a migração:
REAL_MONEY_ENABLED=false
LEGAL_REVIEW_STATUS=pending
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER_CONFIGURED=false
WEBHOOK_SECRET_CONFIGURED=false
KYC_PROVIDER=disabled
KYC_PROVIDER_CONFIGURED=false
KYC_PROVIDER_ADAPTER_READY=false

PLATFORM_COMMISSION_PERCENT=15
TOURNAMENT_COMMISSION_PERCENT=15
FIRST_PLACE_PERCENT=55
SECOND_PLACE_PERCENT=30
THIRD_PLACE_PERCENT=15
MIN_WITHDRAWAL_AMOUNT_CENTS=1000
WITHDRAWAL_FEE_CENTS=0
DEFAULT_DAILY_ENTRY_LIMIT_CENTS=10000
DEFAULT_DAILY_DEPOSIT_LIMIT_CENTS=50000
QUARTETO_MATCH_DURATION_MS=120000
CONTEXTO_MATCH_DURATION_MS=120000
ENABLE_TOURNAMENTS=true
ENABLE_ASYNC_PVP=true
ASYNC_OFFER_AFTER_MS=20000
ASYNC_CHALLENGE_TTL_MS=86400000
ENABLE_DAILY_CHALLENGES=true

DATABASE_URL=postgres://lexora:lexora_dev_only@127.0.0.1:5432/lexora
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
DATA_ENCRYPTION_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
CPF_LOOKUP_SECRET=gere-uma-chave-separada-para-hash-de-busca-do-cpf
ADMIN_API_TOKEN=gere-um-token-administrativo-com-pelo-menos-32-caracteres

# Adaptador Efí. Certificado em Base64, nunca um caminho público.
EFI_SANDBOX=true
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE_BASE64=
EFI_PIX_KEY=
EFI_API_BASE_URL=https://pix-h.api.efipay.com.br

# O proxy mTLS deve acrescentar a prova interna e assinar o corpo encaminhado.
WEBHOOK_SECRET=
WEBHOOK_TRUSTED_PROXY_SECRET=
